# ---- TokenRouter (OpenAI-compatible) ----
# One base URL + one API key powers every model below.
# Get the base URL + key from your opencode.json tokenrouter provider block.
BASE_URL=https://api.tokenrouter.com/v1
API_KEY=sk-your-tokenrouter-key
MODEL=qwen/qwen3.8-max-free
TEMPERATURE=0.3

# ---- Multi-LLM routing tiers ----
# Each tier falls back to the default above if left blank. All tiers can point
# at the same TokenRouter base + key (Qwen 3.8 Max Free).

# Simple tasks (Q&A, greetings) -> cheap, fast
SIMPLE_MODEL=qwen/qwen3.8-max-free
SIMPLE_BASE_URL=https://api.tokenrouter.com/v1
SIMPLE_API_KEY=

# Medium tasks (light analysis / single tool) -> cheap, fast
MEDIUM_MODEL=qwen/qwen3.8-max-free
MEDIUM_BASE_URL=https://api.tokenrouter.com/v1
MEDIUM_API_KEY=

# Complex tasks (research, crawling, building files) -> strongest model
COMPLEX_MODEL=qwen/qwen3.8-max-free
COMPLEX_BASE_URL=https://api.tokenrouter.com/v1
COMPLEX_API_KEY=

# Routing mode: auto (heuristic first, cheap-LLM only for ambiguous), llm, or heuristic
MODEL_ROUTING=auto

# ---- Code editing scope ----
# Root directory the agent's filesystem tools (read_file / edit_file /
# write_file / grep / glob) operate on. Leave unset for the safe sandbox
# (workspace/). Point it at a real repo to let the agent modify or add
# features in actual source files, e.g. this project itself:
# AGENT_LEGACY_EDIT_ROOT=D:/agents/components
AGENT_LEGACY_EDIT_ROOT=

# TinyFish web search
TINYFISH_API_KEY=
TINYFISH_ENDPOINT=https://api.search.tinyfish.ai

# ---- Voice: text-to-speech (TTS) + speech-to-text (STT) via OpenRouter ----
# TTS: synthesize spoken narration from agent events. Free tier = no latency/uptime guarantees.
# STT: transcribe the user's spoken input. Both reuse the same BASE_URL + API_KEY as the LLMs.
TTS_MODEL=fish-audio/s2.1-pro-free:free
STT_MODEL=fish-audio/transcribe-1